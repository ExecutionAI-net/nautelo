# Copy to deploy/.env and fill in. Never commit deploy/.env.
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://api.example.com
DATABASE_URL=postgres://nauta:change-me@postgres:5432/nauta
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MEDIA_PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
INTERNAL_SERVICE_SECRET=generate-a-long-random-string
CONTACT_HASH_SECRET=generate-a-long-random-string
TRUSTED_PROXY_COUNT=1
PUBLIC_BASE_URL=https://example.com
DEFAULT_FROM_EMAIL=NAUTA <no-reply@example.com>
REFRESH_COOKIE_SECURE=true
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL=https://example.com
