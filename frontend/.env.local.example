# 127.0.0.1, not localhost: this value is read during SSR in Node, and a
# machine that resolves localhost to IPv6 ::1 breaks those requests. Matches
# the fallback and the comment in src/lib/api/directory.ts.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8020
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3020
